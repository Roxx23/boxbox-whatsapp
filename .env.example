# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WABA_ID=your_waba_id_here

# Default country code for phone numbers (without +)
# Used when converting local format (0xxx) to international format
# Default: 91 (India)
DEFAULT_COUNTRY_CODE=91

# Flask Secret Key (generate a random string)
SECRET_KEY=your_secret_key_here

# Webhook Configuration
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Shopify Integration (Optional)
SHOPIFY_SHOP_NAME=your-store-name
SHOPIFY_ACCESS_TOKEN=shpat_your_shopify_token_here

# Rate Limiting Configuration (Optional)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1.0
MESSAGE_QUEUE_WORKERS=1

# Logging (Optional)
LOG_FILE=logs.csv

# ============================================================
# PERSISTENT STORAGE FOR PRODUCTION (Render.com)
# ============================================================
# Uncomment and set these when deploying to Render with persistent disk
# After adding a disk mounted at /data, set these environment variables:

# DATABASE_PATH=/data/whatsapp_dashboard.db
# LOG_FILE_PATH=/data/logs.csv
# USERS_FILE_PATH=/data/users.json

# For local development, leave commented (uses current directory)

